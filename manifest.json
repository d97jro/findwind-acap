{
    "schemaVersion": "2.0.0",
    "acapPackageConf": {
        "setup": {
            "appName": "findwind",
            "friendlyName": "Findwind Overlay",
            "vendor": "joakim.roubert@gmail.com",
            "vendorId": "4427158db3",
            "vendorUrl": "https://github.com/d97jro",
            "runMode": "respawn",
            "version": "1.1.4",
            "compatibleOsVersions": [
                {
                    "min": "11.11.226",
                    "max": "13"
                }
            ]
        },
        "configuration": {
            "paramConfig": [
                {
                    "name": "TargetCamera",
                    "type": "int:min=1",
                    "default": "1"
                },
                {
                    "name": "FindwindSpotID",
                    "type": "int:min=1",
                    "default": "301"
                },
                {
                    "name": "Style",
                    "type": "enum:1A|Round corners with border, 1B|Round corners no border, 1C|Square corners with border",
                    "default": "1A"
                },
                {
                    "name": "Opacity",
                    "type": "double:min=0,max=1",
                    "default": "0.7"
                },
                {
                    "name": "Position",
                    "type": "enum:topLeft|Top left, topRight|Top right, bottomLeft|Bottom left, bottomRight|Bottom right, custom|Custom position",
                    "default": "topLeft"
                },
                {
                    "name": "Scale",
                    "type": "int:min=10,max=900",
                    "default": "100"
                },
                {
                    "name": "CustomPositionX",
                    "type": "double:min=-1,max=1",
                    "default": "0"
                },
                {
                    "name": "CustomPositionY",
                    "type": "double:min=-1,max=1",
                    "default": "0"
                }
            ]
        }
    },
    "resources": {
        "dbus": {
            "requiredMethods": [
                "com.axis.HTTPConf1.VAPIXServiceAccounts1.GetCredentials"
            ]
        }
    }
}
